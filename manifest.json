{
  "manifest_version": 3,
  "name": "SAFE-PreserveHub",
  "version": "1.0.0",
  "description": "Contador de acionamentos realizados no PreserveHub.",
  
  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://preserve.cedae.com.br/*",
    "http://preserve.faetec.rj.gov.br/*",
    "https://preserve.faetec.rj.gov.br/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://preserve.cedae.com.br/*",
        "http://preserve.faetec.rj.gov.br/*",
        "https://preserve.faetec.rj.gov.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": "Logo_SAFE.png",
    "default_title": "SAFE-PreserveHub"
  }
}