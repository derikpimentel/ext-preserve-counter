{
  "manifest_version": 3,
  "name": "Contador de Acionamentos SAFE",
  "version": "1.0.0",
  "description": "Conta apenas as confirmações após Enviar para Aprovação no PreserveHub.",
  
  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://preserve.cedae.com.br/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://preserve.cedae.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": "Logo_SAFE.png"
  }
}