{
  "manifest_version": 3,
  "name": "SAFE-PreserveHub",
  "version": "1.0.0",
  "description": "Contador de acionamentos realizados no PreserveHub.",

  "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
  },
  
  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://preserve.cedae.com.br/*",
    "http://preserve.faetec.rj.gov.br/*",
    "https://preserve.faetec.rj.gov.br/*",
    "http://preserve.proderj.rj.gov.br/*",
    "http://preserve.detro.rj.gov.br/*",
    "http://preserve.casacivil.rj.gov.br/*",
    "http://preserve.sedsdh.rj.gov.br/*",
    "http://preserve.procon.rj.gov.br/*",
    "http://preserve/*",
    "http://preserve.degase.rj.gov.br.local/*",
    "http://monaco-preserve.safeconversaodigital.com.br/*",
    "https://monaco-preserve.safeconversaodigital.com.br/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://preserve.cedae.com.br/*",
        "http://preserve.faetec.rj.gov.br/*",
        "https://preserve.faetec.rj.gov.br/*",
        "http://preserve.proderj.rj.gov.br/*",
        "http://preserve.detro.rj.gov.br/*",
        "http://preserve.casacivil.rj.gov.br/*",
        "http://preserve.sedsdh.rj.gov.br/*",
        "http://preserve.procon.rj.gov.br/*",
        "http://preserve/*",
        "http://preserve.degase.rj.gov.br.local/*",
        "http://monaco-preserve.safeconversaodigital.com.br/*",
        "https://monaco-preserve.safeconversaodigital.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "default_title": "SAFE-PreserveHub"
  }
}